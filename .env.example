# Template only (placeholders). Copy to .env (git-ignored) and fill in locally.
# Never commit real keys; in CI use GitHub Actions secrets.
#
# Read by FreeLLMRouter (src/client/free-llm-router.ts) — default providers, free tiers:
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
#
# Read by the client but no provider adapter exists yet (unused):
COHERE_API_KEY=your_cohere_api_key_here
CLOUDFLARE_API_TOKEN=your_api_token_here
# Not read anywhere in src/ (kept for a future Cloudflare adapter):
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
#
# Adapters exist but the client does not load these, and the catalog has no models
# for them. Together AI and Replicate are paid (no free tier) as of 2026-10-01.
TOGETHER_API_KEY=your_together_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
REPLICATE_API_KEY=your_replicate_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

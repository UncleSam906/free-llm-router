{
  "name": "free-llm-router",
  "version": "0.1.0",
  "description": "Free tier LLM API routing client with automatic waterfall failover",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "dev": "ts-node src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "llm",
    "openai",
    "groq",
    "mistral",
    "gemini",
    "cohere",
    "cloudflare",
    "routing",
    "waterfall",
    "failover"
  ],
  "author": "Jason",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "optionalDependencies": {
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.1.0",
    "vitest": "^1.0.0"
  }
}
